<?xml version="1.0" encoding="utf-8"?>
<!--
  Die Oberfläche ist vollständig Compose-basiert. Dieses XML-Theme wirkt nur
  beim Kaltstart, damit statt einer weißen Fläche sofort der passende
  Hintergrund erscheint. Die dunkle Entsprechung liegt unter values-night.
-->
<resources>
    <style name="Theme.Commentator" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
