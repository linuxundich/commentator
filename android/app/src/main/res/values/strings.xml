    <string name="setup_title">WordPress verbinden</string>
    <string name="setup_add_title">Blog hinzufügen</string>
    <string name="setup_url_explanation">Gib die Adresse deines Blogs ein. Commentator prüft, ob dort eine WordPress-REST-API erreichbar ist.</string>
    <string name="setup_url_label">Blog-Adresse</string>
    <string name="setup_url_https_hint">Nur HTTPS. Unverschlüsselte Verbindungen werden abgelehnt.</string>
    <string name="setup_authorize_explanation">Du wirst zu %1$s weitergeleitet und meldest dich dort in deinem Browser an. Commentator erhält danach ausschließlich ein Application Password, das du in WordPress jederzeit einzeln widerrufen kannst. Dein Kontokennwort sieht die App nie.</string>
    <string name="setup_manual_explanation">Erzeuge in WordPress unter „Benutzer → Profil → Application Passwords“ ein Passwort und trage es hier ein.</string>
    <string name="setup_username_label">Benutzername</string>
    <string name="setup_app_password_label">Application Password</string>
    <string name="setup_app_password_hint">Leerzeichen dürfen enthalten sein, sie werden entfernt.</string>

