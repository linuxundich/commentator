    <string name="settings_threaded">Kommentarfaden</string>
    <string name="settings_threaded_description">Antworten stehen eingerückt unter dem Kommentar, auf den sie sich beziehen. Fäden mit neuen Beiträgen stehen oben. Abgeschaltet bleibt es bei einer rein chronologischen Liste.</string>
    <string name="settings_section_privacy">Datenschutz</string>
