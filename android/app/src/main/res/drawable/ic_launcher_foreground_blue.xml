<!--
  Zweite Symbolvariante, in den Einstellungen wählbar.

  Gleiche Zeichnung wie die grüne Variante, aber umgekehrt eingefärbt: weisse
  Blase auf WordPress-Blau. Grund ist die Ablesbarkeit - blau auf dem dunklen
  Grund erreicht nur 3,3:1 Kontrast und der Schweif verschwindet bei kleinen
  Grössen. So sind es 5,6:1 in beide Richtungen, bei unveränderter Markenfarbe.

  Die Zeichnung sitzt vier Einheiten unterhalb der Rastermitte. Das ist
  Absicht: Der Blasenkörper trägt fast die gesamte Fläche, der Schweif wiegt
  kaum etwas. Geometrisch mittig ausgerichtet wirkte die Marke deshalb nach
  oben gerutscht. So liegt der Flächenschwerpunkt bei 53,4 statt 49,1.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.05"
        android:scaleY="1.05">

        <path android:fillColor="#FFFFFF" android:pathData="M40,32 H68 A14,14 0 0 1 82,46 V60 A14,14 0 0 1 68,74 H52 L36,84 L44,74 H40 A14,14 0 0 1 26,60 V46 A14,14 0 0 1 40,32 Z" />

        <path
            android:strokeColor="#3858E9"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M43,46 L48.5,60 L54,50.5 L59.5,60 L65,46" />
    </group>
</vector>
