<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Die App selbst fordert genau drei Berechtigungen an, jede begründet.
      WorkManager steuert beim Zusammenführen der Manifeste weitere bei
      (WAKE_LOCK, RECEIVE_BOOT_COMPLETED, FOREGROUND_SERVICE); sie sind in
      docs/privacy.md aufgeführt.
      INTERNET            - Zugriff auf die WordPress-REST-API
      ACCESS_NETWORK_STATE - Offline-Erkennung und Bedingung für Hintergrundarbeit
      POST_NOTIFICATIONS  - Hinweis auf neue Kommentare (ab Android 13)
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".CommentatorApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Commentator">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Commentator">

            <!--
              Deep Link aus Benachrichtigungen und Rücksprung aus dem
              WordPress-Autorisierungs-Flow. Ein eigenes Schema, weil die App
              keine Website besitzt, deren Adressraum sie beanspruchen könnte.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="commentator" />
            </intent-filter>
        </activity>

        <!--
          Das Startsymbol ist umschaltbar. Android kennt dafür keinen direkten
          Weg, deshalb gibt es je Variante einen Alias auf dieselbe Activity;
          eingeschaltet ist immer genau einer. Umgeschaltet wird in
          AppIconManager.

          Die MAIN/LAUNCHER-Filter liegen deshalb hier und nicht an der
          Activity selbst - sonst gäbe es dauerhaft einen zusätzlichen,
          nicht abschaltbaren Eintrag im Startbildschirm.
        -->
        <activity-alias
            android:name=".LauncherGreen"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherBlue"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_blue"
            android:roundIcon="@mipmap/ic_launcher_blue_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
          Knöpfe in der Benachrichtigung: Freigeben, Spam, Antworten. Nicht
          exportiert - nur die eigenen Benachrichtigungen dürfen hierher.
        -->
        <receiver
            android:name=".notification.NotificationActionReceiver"
            android:exported="false" />

        <!--
          Sofortmeldung über UnifiedPush (optional). Nicht exportiert: Der
          Connector leitet die Meldungen der UnifiedPush-App intern hierher.
        -->
        <service
            android:name=".push.CommentatorPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <!--
          Der Standard-Initialisierer von WorkManager wird abgeschaltet, weil
          die Konfiguration aus CommentatorApplication kommt - nur so erhält
          der Worker seine Abhängigkeiten über Hilt.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
